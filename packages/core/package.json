{
  "name": "@ingredient-icons/core",
  "version": "0.5.0",
  "description": "Soft 3D icons for cooking ingredients, keyed by ingredient catalog ids, with a CC0 snapshot of the catalog",
  "license": "(MIT AND CC0-1.0)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": "./icons/*",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "icons", "catalog.json", "LICENSE", "LICENSE-ICONS", "NOTICE"],
  "sideEffects": false,
  "keywords": ["icons", "ingredients", "food", "recipe", "emoji"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EBf-Studio/ingredient-icons.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "bun scripts/generate.ts && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepack": "bun run build"
  }
}
